{
  "name": "stock-jargon-explainer",
  "version": "0.1.0",
  "private": true,
  "description": "股票黑话解释器 — 面向金融小白的术语查询 + 测验 Web 工具",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @jargon/web dev",
    "build": "pnpm --filter @jargon/content run ingest && pnpm --filter @jargon/web run build",
    "start": "pnpm --filter @jargon/web start",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @jargon/db run db:generate",
    "db:migrate": "pnpm --filter @jargon/db run db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
